# Copy to .env and fill in. Never commit .env.
# Non-empty values here take precedence over variables already set in your shell.

# LLM provider: gemini (free tier) or anthropic (paid).
AUDITOR_PROVIDER=gemini

# Required when AUDITOR_PROVIDER=gemini. Free key: https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=

# Required when AUDITOR_PROVIDER=anthropic. https://console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=

# Optional: model id (empty = provider default: gemini-3.5-flash-lite / claude-opus-5-5).
AUDITOR_MODEL=

# Optional: reasoning effort: low | medium | high (| xhigh | max for Anthropic). Empty = provider default.
AUDITOR_EFFORT=

# Optional: maximum agent steps (LLM turns) per audit (default 40).
AUDITOR_MAX_STEPS=
